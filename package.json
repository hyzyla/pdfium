{
  "name": "@hyzyla/pdfium",
  "version": "2.1.13",
  "description": "Universal wrapper for PDFium",
  "license": "MIT",
  "author": "Yevhenii Hyzyla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyzyla/pdfium"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "browser": {
    "fs": false,
    "url": false,
    "node": false,
    "path": false,
    "crypto": false,
    "module": false
  },
  "types": "dist/index.esm.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.esm.d.ts",
        "default": "./dist/index.esm.browser.js"
      },
      "import": {
        "types": "./dist/index.esm.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.cjs.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser/cdn": {
      "types": "./dist/index.esm.cdn.d.ts",
      "default": "./dist/index.esm.cdn.js"
    },
    "./browser/base64": {
      "types": "./dist/index.esm.base64.d.ts",
      "default": "./dist/index.esm.base64.js"
    },
    "./worker": {
      "types": "./dist/index.esm.worker.d.ts",
      "default": "./dist/index.esm.worker.js"
    },
    "./pdfium.wasm": "./dist/pdfium.wasm",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:watch": "rolldown -c --watch",
    "build:prod": "rolldown -c --environment NODE_ENV:production && tsc --emitDeclarationOnly && node scripts/build-cjs-types.mjs",
    "clean": "rm -rf dist",
    "check:fix": "oxlint --fix && oxfmt",
    "check:ci": "oxlint && oxfmt --check",
    "check:package": "vitest run --project package",
    "check:test": "vitest --project unit",
    "check:types": "tsc --noEmit",
    "update:pdfium": "node scripts/update-pdfium.mjs"
  },
  "devDependencies": {
    "@types/jest-image-snapshot": "^6.4.2",
    "@types/node": "^24.19.2",
    "jest-image-snapshot": "^6.5.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright-core": "^1.64.0",
    "rolldown": "^1.2.13",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "unzipper": "^0.12.5",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "webpack": "^5.111.1"
  }
}
