{
  "name": "@hyzyla/pdfium",
  "version": "2.1.13",
  "description": "Universal wrapper for PDFium",
  "license": "MIT",
  "author": "Yevhenii Hyzyla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyzyla/pdfium"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "browser": {
    "fs": false,
    "url": false,
    "node": false,
    "path": false,
    "crypto": false,
    "module": false
  },
  "types": "dist/index.esm.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.esm.d.ts",
        "default": "./dist/index.esm.browser.js"
      },
      "import": {
        "types": "./dist/index.esm.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.cjs.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser/cdn": {
      "types": "./dist/index.esm.cdn.d.ts",
      "default": "./dist/index.esm.cdn.js"
    },
    "./browser/base64": {
      "types": "./dist/index.esm.base64.d.ts",
      "default": "./dist/index.esm.base64.js"
    },
    "./worker": {
      "types": "./dist/index.esm.worker.d.ts",
      "default": "./dist/index.esm.worker.js"
    },
    "./pdfium.wasm": "./dist/pdfium.wasm",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:watch": "rollup --config rollup.config.mjs --watch",
    "build:prod": "rollup --config rollup.config.mjs --environment NODE_ENV:production",
    "clean": "rm -rf dist",
    "check:fix": "oxlint --fix && oxfmt",
    "check:ci": "oxlint && oxfmt --check",
    "check:test": "vitest",
    "check:types": "tsc --noEmit",
    "update:pdfium": "node scripts/update-pdfium.mjs"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest-image-snapshot": "^6.4.0",
    "@types/node": "^20.19.25",
    "jest-image-snapshot": "^6.5.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "rollup": "^4.53.3",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-delete": "^3.0.1",
    "sharp": "^0.34.5",
    "ts-node": "^10.9.1",
    "tslib": "^2.8.1",
    "unzipper": "^0.12.3",
    "vitest": "^2.1.9"
  }
}
